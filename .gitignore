# ============================================================
# ARQUIVO .gitignore — PADRÃO PYTHON + PYINSTALLER + TESTES
# ============================================================

# Bytecode e caches do Python
__pycache__/
*.py[cod]
*$py.class

# Caches de testes e cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.json

# Pastas temporárias de compilação do PyInstaller (mantendo os .exe finais na raiz do repositório)
build/
dist/
*.spec

# Arquivos temporários do Microsoft Word e do Sistema Operacional
~$*.docx
Thumbs.db
Desktop.ini

# Ambientes virtuais (caso criados localmente)
.venv/
venv/
env/
